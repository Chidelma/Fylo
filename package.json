{
    "name": "@d31ma/fylo",
    "version": "26.30.05-1",
    "private": true,
    "packageManager": "bun@1.3.11",
    "type": "module",
    "bin": {
        "fylo": "src/cli/index.js"
    },
    "scripts": {
        "vendor:install": "sh ./scripts/install-vendor-bins.sh",
        "build:exe": "bun ./scripts/build-executable.mjs",
        "build:web": "bun ./scripts/build-browser.mjs",
        "build:web:wasm": "bun ./scripts/build-browser.mjs --wasm",
        "browser:wasm:budgets": "bun ./scripts/verify-browser-wasm-budgets.mjs",
        "browser:wasm:e2e": "node ./node_modules/@playwright/test/cli.js test",
        "contracts:verify": "bun ./scripts/verify-rust-contracts.mjs",
        "golden:generate": "bun ./scripts/generate-rust-golden-root.mjs",
        "golden:smoke": "bun ./scripts/smoke-rust-golden-root.mjs",
        "golden:verify": "bun ./scripts/verify-rust-golden-root.mjs",
        "query:verify": "bun ./scripts/verify-rust-query-fixture.mjs",
        "predicate:verify": "bun ./scripts/verify-rust-predicate-fixture.mjs",
        "rust:oracle:record": "bun ./scripts/record-released-rust-oracle.mjs",
        "rust:oracle:restore": "bun ./scripts/restore-rust-oracle-metadata.mjs",
        "rust:oracle:verify": "bun ./scripts/verify-released-rust-oracle.mjs",
        "sql:verify": "bun ./scripts/verify-rust-sql-fixture.mjs",
        "rust:check": "bun ./scripts/run-rust.mjs cargo check --workspace --all-targets",
        "rust:clippy": "bun ./scripts/run-rust.mjs cargo clippy --workspace --all-targets --all-features -- -D warnings",
        "rust:clippy:cross": "bun ./scripts/clippy-cross-targets.mjs",
        "rust:deny": "bun ./scripts/run-rust.mjs cargo deny check",
        "rust:fmt": "bun ./scripts/run-rust.mjs cargo fmt --all --check",
        "rust:interop:readonly": "bun ./scripts/verify-rust-readonly.mjs",
        "rust:interop:writes": "bun ./scripts/verify-rust-write-interop.mjs",
        "rust:interop:encrypted": "bun ./scripts/verify-rust-encrypted-writes.mjs",
        "rust:interop:versioned": "bun ./scripts/verify-rust-versioned-writes.mjs",
        "rust:interop:machine": "bun ./scripts/verify-rust-machine-protocol.mjs",
        "rust:crash:matrix": "bun ./scripts/verify-rust-crash-matrix.mjs",
        "rust:benchmark:readonly": "bun ./scripts/benchmark-rust-readonly.mjs",
        "rust:test": "bun ./scripts/run-rust.mjs cargo test --workspace --all-features",
        "rust:verify": "bun ./scripts/run-rust.mjs cargo run -p xtask -- verify-workspace",
        "test": "bun --env-file=tests/.env.test test tests/integration tests/collection tests/browser --timeout 120000",
        "test:par": "node ./scripts/test-parallel.mjs",
        "test:interop": "bun test tests/interop --timeout 120000 --parallel=1",
        "typecheck": "tsc --noEmit",
        "lint": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" README.md",
        "format": "prettier --write src tests"
    },
    "devDependencies": {
        "@playwright/test": "1.62.0",
        "@types/bun": "^1.2.19",
        "@types/node": "^20.19.39",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^9.0.0",
        "prettier": "^3.0.0",
        "typescript": "^5.9.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d31ma/Fylo.git"
    },
    "homepage": "https://fylo.del.ma",
    "license": "MIT",
    "keywords": [
        "storage",
        "database",
        "filesystem",
        "document-store",
        "javascript",
        "jsdoc",
        "executable"
    ],
    "author": "Chidelma",
    "bugs": {
        "url": "https://github.com/d31ma/Fylo/issues"
    }
}
